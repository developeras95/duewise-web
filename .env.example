# =====================================================================================
# duewise-web: settings for `docker compose up`
# =====================================================================================
#
# HOW TO USE
#   1. Copy this file to .env in the same folder:
#        Windows:      copy .env.example .env
#        macOS/Linux:  cp .env.example .env
#   2. Uncomment (remove the leading "# ") and fill in only the lines you need.
#   3. Apply:  docker compose up -d
#      Check what the containers will receive:  docker compose config
#
# .env is ignored by git: it may hold passwords. Never commit it.
# Anything left commented out uses the default from compose.yaml: everything in Docker,
# every email caught by Mailpit at http://localhost:8026.
#
# FORMAT RULES
#   - One NAME=value per line, no spaces around "=". No quotes needed, even with spaces.
#   - "#" starts a comment only at the beginning of a line.
#   - A "$" in a value must be written as "$$" (Compose treats "$" as a variable).


# ---- Ports on your computer ---------------------------------------------------------
# WEB_PORT=3000        the app
# API_PORT=8090        the API directly (only reachable from this computer)
# MAILPIT_PORT=8026    the email inbox (Duewise's own compose uses 8025)


# ---- Which Duewise API ----------------------------------------------------------------
# A released version from https://github.com/developeras95/duewise-invoicing-api/releases
# Emailing invoices needs 1.1.0 or later.
# DUEWISE_VERSION=1.1.0


# ---- Another database, e.g. the 5-million-invoice performance study -------------------
# The study (github.com/developeras95/duewise-postgres-performance) runs its own PostgreSQL on
# port 5433 of your computer. Its tables were created without Flyway, so Flyway must accept them
# as they are (baseline) instead of trying to create them again.
# DB_URL=jdbc:postgresql://host.docker.internal:5433/duewise
# SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
# SPRING_FLYWAY_BASELINE_VERSION=5
#
# With that database, also switch off the daily reminder job: at 09:00 it would load every one of
# its ~590,000 overdue invoices at once and email their clients (into Mailpit). "Run now" in the
# app still works when you want it.
# REMINDERS_SCHEDULER_ENABLED=false


# ---- Real email instead of Mailpit (all seven lines together) -----------------------
# Gmail: use an app password from https://myaccount.google.com/apppasswords
# (needs 2-Step Verification), 16 letters, no spaces. Never your normal password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# SPRING_MAIL_USERNAME=you@gmail.com
# SPRING_MAIL_PASSWORD=your16letterapppassword
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=Duewise <you@gmail.com>
#
# Careful: with real email on, every overdue invoice emails its client's billing
# address. Use test clients with addresses you own.


# ---- Your business on invoices and emails -------------------------------------------
# BUSINESS_EMAIL=billing@yourbusiness.com
#
# The time zone that decides "today" for issue dates and overdue checks (default Asia/Kolkata).
# BUSINESS_TIME_ZONE=Europe/London
