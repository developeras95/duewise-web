{"openapi":"3.1.0","info":{"title":"Duewise API","description":"Invoicing, payments and overdue reminders for freelancers and small businesses.\nManage clients, raise invoices, record payments and see what is overdue.","version":"1.0.0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Clients","description":"Customers that invoices are raised for"},{"name":"Reminders","description":"Overdue reminders to clients and the owner's daily summary"},{"name":"Payments","description":"Money received against an invoice"},{"name":"Payment methods","description":"Ways clients can pay an invoice"},{"name":"Invoices","description":"Draft, send and void invoices"},{"name":"Statements","description":"What a client owes and how late it is"},{"name":"Currencies","description":"Currencies that invoices can be raised in"}],"paths":{"/api/v1/settings/reminders":{"get":{"tags":["Reminders"],"summary":"Get reminder settings","operationId":"get","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReminderSettings"}}}}}},"put":{"tags":["Reminders"],"summary":"Replace reminder settings","description":"Switches, owner-summary recipients (TO / CC) and reminder days, all at once. Requires the current 'version'. Takes effect on the next run, no restart needed.","operationId":"update","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReminderSettingsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReminderSettings"}}}}}}},"/api/v1/invoices/{id}":{"get":{"tags":["Invoices"],"summary":"Get one invoice with its line items","operationId":"get_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Invoice"}}}}}},"put":{"tags":["Invoices"],"summary":"Replace a draft","description":"Only drafts can be changed. The lines sent replace all existing lines. Requires the current 'version'.","operationId":"update_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvoiceRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Invoice"}}}}}},"delete":{"tags":["Invoices"],"summary":"Delete a draft","description":"Sent invoices cannot be deleted; void them instead.","operationId":"delete","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK"}}}},"/api/v1/clients/{id}":{"get":{"tags":["Clients"],"summary":"Get one client","operationId":"get_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Client"}}}}}},"put":{"tags":["Clients"],"summary":"Replace a client","description":"Send every field plus the 'version' from your last GET. Optional fields you leave out are cleared. Returns 409 if the client was changed by someone else in the meantime.","operationId":"update_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClientRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Client"}}}}}}},"/api/v1/reminders/run":{"post":{"tags":["Reminders"],"summary":"Run the reminder job now","description":"Does exactly what the daily schedule does. Safe to repeat: reminders already sent are never sent again, and the owner summary goes out at most once a day.","operationId":"run","responses":{"200":{"descri