","required":false,"schema":{"type":"integer","format":"int32","default":0,"minimum":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20,"maximum":100,"minimum":1}},{"name":"sort","in":"query","description":"issueDate, dueDate, total, invoiceNumber or createdAt","required":false,"schema":{"type":"string","default":"issueDate","pattern":"issueDate|dueDate|total|invoiceNumber|createdAt"}},{"name":"direction","in":"query","required":false,"schema":{"type":"string","default":"desc","pattern":"asc|desc"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseInvoiceSummary"}}}}}},"post":{"tags":["Invoices"],"summary":"Create a draft invoice","description":"Currency, issue date and due date default from the client and today. Totals are calculated for you.","operationId":"create_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvoiceRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Invoice"}}}}}}},"/api/v1/invoices/{invoiceId}/payments":{"get":{"tags":["Payments"],"summary":"List an invoice's payments","description":"Oldest first.","operationId":"list_2","parameters":[{"name":"invoiceId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Payment"}}}}}}},"post":{"tags":["Payments"],"summary":"Record a payment","description":"Only for SENT or PARTIALLY_PAID invoices. Moves the invoice to PARTIALLY_PAID, or PAID when the balance reaches zero. Overpayments are refused (422).","operationId":"record","parameters":[{"name":"invoiceId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaymentRequest"}}},"require